{
  "name": "@usevibejs/motion",
  "version": "0.1.0",
  "description": "Animations, springs, gestures, scroll, layout and presence for vibe.js, powered by Motion.",
  "keywords": [
    "animation",
    "gestures",
    "motion",
    "spring",
    "transitions",
    "vibejs"
  ],
  "homepage": "https://github.com/vibejs/vibemotion#readme",
  "bugs": {
    "url": "https://github.com/vibejs/vibemotion/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibejs/vibemotion.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mini": {
      "types": "./dist/mini.d.ts",
      "import": "./dist/mini.js",
      "default": "./dist/mini.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite examples/demo --host 127.0.0.1",
    "build": "tsdown",
    "build:demo": "vite build examples/demo",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit && pnpm --dir examples/demo exec tsc -b --runExternalCode && pnpm --dir examples/demo exec tsc -b ../../test/tsconfig.json --runExternalCode",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt src test scripts benchmarks examples *.ts *.json .changeset",
    "fmt:check": "oxfmt --check src test scripts benchmarks examples *.ts *.json .changeset",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "pnpm build:demo && node scripts/browser.ts",
    "test:package": "node scripts/package.ts",
    "bench": "pnpm build:demo && node benchmarks/run.ts",
    "size": "node scripts/size.ts",
    "check": "pnpm fmt:check && pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm build && pnpm test:browser && pnpm test:package && pnpm size",
    "version-packages": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "motion": "14.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.2",
    "@usevibejs/compiler": "0.1.0",
    "@usevibejs/language-tools": "0.1.0",
    "@usevibejs/ui": "0.1.0",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@usevibejs/ui": "^0.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26"
  },
  "packageManager": "pnpm@12.14.0"
}
