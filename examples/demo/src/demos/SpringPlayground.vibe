<script setup lang="ts">
import { computed, ref, useTemplateRef } from '@usevibejs/ui';
import { useMotionStyle, useMotionValueState, useSpring, useTransform } from '@usevibejs/motion';
import Button from '../components/ui/Button.vibe';
import Slider from '../components/ui/Slider.vibe';
import Label from '../components/ui/Label.vibe';

const stiffness = ref([170]);
const damping = ref([12]);
const mass = ref([1]);
const right = ref(false);

// Vibe.js owns the target and the spring options; Motion owns the per-frame value.
const progress = useSpring(
  () => (right.value ? 1 : 0),
  () => ({ stiffness: stiffness.value[0], damping: damping.value[0], mass: mass.value[0] }),
);

const ball = useTemplateRef<HTMLElement>('ball');
const track = useTemplateRef<HTMLElement>('track');
const x = useTransform(() => progress.get() * ((track.value?.clientWidth ?? 64) - 64));
// Motion writes the transform in its frame loop: no Vibe.js render per frame.
useMotionStyle(ball, { x });

// Explicit, opt-in reactive observation for the numeric readout only.
const live = useMotionValueState(progress);
const readout = computed(() => live.value.toFixed(3));
</script>

<template>
  <div class="grid gap-6 md:grid-cols-[1fr_240px]">
    <div class="space-y-4">
      <div ref="track" class="relative h-16 rounded-lg border bg-muted/40 p-2">
        <div ref="ball" data-testid="spring-ball" class="size-12 rounded-full bg-primary shadow-sm"></div>
      </div>
      <div class="flex items-center gap-3">
        <Button data-testid="spring-toggle" @click="right = !right">Move {{ right ? 'left' : 'right' }}</Button>
        <span class="font-mono text-xs text-muted-foreground">progress <output data-testid="spring-value">{{ readout }}</output></span>
      </div>
      <p class="text-xs text-muted-foreground">
        Change the sliders while the ball moves: the spring retargets from its current velocity.
      </p>
    </div>
    <div class="space-y-4">
      <div class="space-y-2">
        <Label>Stiffness {{ stiffness[0] }}</Label>
        <Slider v-model="stiffness" :min="20" :max="600" :labels="['Stiffness']" />
      </div>
      <div class="space-y-2">
        <Label>Damping {{ damping[0] }}</Label>
        <Slider v-model="damping" :min="1" :max="60" :labels="['Damping']" />
      </div>
      <div class="space-y-2">
        <Label>Mass {{ mass[0] }}</Label>
        <Slider v-model="mass" :min="1" :max="10" :labels="['Mass']" />
      </div>
    </div>
  </div>
</template>
