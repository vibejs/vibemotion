    <DemoCard id="spring" title="1 · Spring playground" description="A spring-driven motion value bound straight to a transform. Retarget mid-flight; velocity carries over." :apis="['useSpring', 'useTransform', 'useMotionStyle']"><SpringPlayground /></DemoCard>
