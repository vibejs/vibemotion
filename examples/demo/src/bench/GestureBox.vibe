<script setup lang="ts">
import { useTemplateRef } from '@usevibejs/ui';
import { useDrag, useMotion } from '@usevibejs/motion';

const box = useTemplateRef<HTMLElement>('box');
useMotion(box, { animate: { scale: 1 }, hover: { scale: 1.2 }, press: { scale: 0.9 }, transition: { duration: 0.2 } });
useDrag(box, { snapToOrigin: true });
</script>

<template>
  <button ref="box" type="button" data-gesture-box class="size-6 rounded bg-primary/60" aria-label="Gesture target"></button>
</template>
