<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { computed } from '@usevibejs/ui';
import type { ClassValue } from '@usevibejs/ui';
import { cn } from '../../lib/utils.ts';

defineOptions({ inheritAttrs: false });

const {
  class: className,
  min = 0,
  max = 100,
  step = 1,
  name,
  disabled = false,
  labels = [],
} = defineProps<{
  class?: ClassValue;
  min?: number;
  max?: number;
  step?: number;
  name?: string;
  disabled?: boolean;
  /** An accessible name for each thumb, such as ['Minimum price', 'Maximum price']. */
  labels?: string[];
}>();
/** One value for a single thumb, two for a range. */
const model = defineModel<number[]>({ default: () => [0] });
const percent = (value: number): number => ((value - min) / (max - min)) * 100;
const range = computed(() => ({
  left: model.value.length > 1 ? percent(Math.min(...model.value)) + '%' : '0%',
  right: 100 - percent(Math.max(...model.value)) + '%',
}));

function update(index: number, event: Event): void {
  const input = event.target as HTMLInputElement;
  const values = [...model.value];
  // Thumbs never cross: each stays between its neighbors.
  const lower = values[index - 1] ?? min;
  const upper = values[index + 1] ?? max;
  values[index] = Math.min(upper, Math.max(lower, Number(input.value)));
  input.value = String(values[index]);
  model.value = values;
}
</script>

<template>
  <div data-slot="slider" :data-disabled="disabled || undefined" v-bind="$attrs" :class="cn('relative flex h-4 w-full touch-none items-center select-none data-[disabled]:opacity-50', className)">
    <div data-slot="slider-track" class="relative h-1.5 w-full grow overflow-hidden rounded-full bg-muted">
      <div data-slot="slider-range" class="absolute h-full bg-primary" :style="range" />
    </div>
    <input
      v-for="(value, index) in model"
      :key="index"
      type="range"
      data-slot="slider-thumb"
      :min="min"
      :max="max"
      :step="step"
      :value="value"
      :name="name"
      :disabled="disabled"
      :aria-label="labels[index]"
      class="pointer-events-none absolute inset-0 h-full w-full cursor-default appearance-none bg-transparent outline-none disabled:cursor-not-allowed [&::-moz-range-thumb]:pointer-events-auto [&::-moz-range-thumb]:size-4 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border [&::-moz-range-thumb]:border-primary [&::-moz-range-thumb]:bg-white [&::-moz-range-thumb]:shadow-sm [&::-moz-range-thumb]:transition-[color,box-shadow] [&::-moz-range-track]:bg-transparent [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:size-4 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:border [&::-webkit-slider-thumb]:border-primary [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:shadow-sm [&::-webkit-slider-thumb]:ring-ring/50 [&::-webkit-slider-thumb]:transition-[color,box-shadow] hover:[&::-webkit-slider-thumb]:ring-4 focus-visible:[&::-webkit-slider-thumb]:ring-4 hover:[&::-moz-range-thumb]:ring-4 focus-visible:[&::-moz-range-thumb]:ring-4 [&::-moz-range-thumb]:ring-ring/50"
      @input="update(index, $event)"
    />
  </div>
</template>
