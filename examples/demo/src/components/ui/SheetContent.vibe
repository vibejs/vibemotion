<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import { useTemplateRef } from '@usevibejs/ui';
import type { ClassValue } from '@usevibejs/ui';
import { injectOverlay, useModal } from '../../lib/overlay.ts';
import { cn } from '../../lib/utils.ts';

defineOptions({ inheritAttrs: false });

const { class: className, side = 'right', showCloseButton = true } = defineProps<{
  class?: ClassValue;
  side?: 'top' | 'right' | 'bottom' | 'left';
  showCloseButton?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
const overlay = injectOverlay('Dialog');
const dialog = useTemplateRef<HTMLDialogElement>('dialog');
const { onClose, onClick } = useModal(dialog, overlay.open, () => true);
const sides = {
  right: 'inset-y-0 right-0 left-auto h-full max-h-none w-3/4 border-l sm:max-w-sm translate-x-full open:translate-x-0 starting:open:translate-x-full',
  left: 'inset-y-0 right-auto left-0 h-full max-h-none w-3/4 border-r sm:max-w-sm -translate-x-full open:translate-x-0 starting:open:-translate-x-full',
  top: 'inset-x-0 top-0 bottom-auto h-auto w-full max-w-none border-b -translate-y-full open:translate-y-0 starting:open:-translate-y-full',
  bottom: 'inset-x-0 top-auto bottom-0 h-auto w-full max-w-none border-t translate-y-full open:translate-y-0 starting:open:translate-y-full',
};
</script>

<template>
  <dialog
    ref="dialog"
    data-slot="sheet-content"
    :data-side="side"
    :id="overlay.id + '-content'"
    :aria-labelledby="overlay.id + '-title'"
    :aria-describedby="overlay.id + '-description'"
    :data-state="overlay.open.value ? 'open' : 'closed'"
    v-bind="$attrs"
    :class="cn('m-0 gap-4 bg-background p-0 text-foreground shadow-lg outline-none open:flex open:flex-col backdrop:bg-black/50 transition-[translate,overlay,display] transition-discrete duration-300 ease-in-out open:duration-500 backdrop:transition-[opacity,overlay,display] backdrop:transition-discrete backdrop:duration-300 backdrop:opacity-0 open:backdrop:opacity-100 starting:open:backdrop:opacity-0 motion-reduce:transition-none motion-reduce:backdrop:transition-none', sides[side], className)"
    @close="onClose"
    @click="onClick"
  >
    <slot />
    <button v-if="showCloseButton" type="button" data-slot="sheet-close-button" class="absolute top-4 right-4 rounded-xs opacity-70 ring-offset-background transition-opacity hover:opacity-100 focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:outline-hidden disabled:pointer-events-none [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4" @click="overlay.open.value = false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg><span class="sr-only">Close</span></button>
  </dialog>
</template>
