<!-- Adapted from shadcn/ui under MIT. See vibecn.LICENSE. -->
<script setup lang="ts">
import type { ClassValue } from '@usevibejs/ui';
import { injectOverlay } from '../../lib/overlay.ts';
import Button from './Button.vibe';

defineOptions({ inheritAttrs: false });

const {
  class: className,
  variant = 'outline',
  size = 'default',
  disabled = false,
} = defineProps<{
  class?: ClassValue;
  variant?: 'default' | 'secondary' | 'destructive' | 'outline' | 'ghost' | 'link';
  size?: 'default' | 'xs' | 'sm' | 'lg' | 'icon' | 'icon-xs' | 'icon-sm' | 'icon-lg';
  disabled?: boolean;
}>();
defineSlots<{ default?: (props: {}) => unknown }>();
// Declared, so a listener from the parent runs before the overlay changes state.
const emit = defineEmits<{ click: [event: MouseEvent] }>();
const overlay = injectOverlay('Dialog');
function onClick(event: MouseEvent): void {
  emit('click', event);
  overlay.open.value = false;
}
</script>

<template>
  <Button
    data-slot="dialog-close"
    :variant="variant"
    :size="size"
    :disabled="disabled"
    v-bind="$attrs"
    :class="className"
    @click="onClick"
  ><slot /></Button>
</template>
