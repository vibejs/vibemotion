{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "../../.tsbuild/demo",
    "rootDir": "../..",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "paths": {
      "@usevibejs/motion": ["../../src/index.ts"],
      "@usevibejs/motion/mini": ["../../src/mini.ts"]
    }
  },
  "contentMappers": [{ "package": "@usevibejs/language-tools", "extensions": [".vibe"] }],
  "include": ["src", "../../src"],
  "exclude": ["../../src/**/*.test.ts"]
}
